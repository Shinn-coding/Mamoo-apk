{
  "expo": {
    "name": "Mamoo",
    "slug": "mamoo",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mamoo",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.mamoo.app",
      "adaptiveIcon": {
        "backgroundColor": "#179C51",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#179C51"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mamoo memakai foto pilihanmu hanya untuk foto profil. Foto tetap disimpan di HP ini.",
          "cameraPermission": "Mamoo memakai kamera hanya untuk memotret foto profil. Foto tetap disimpan di HP ini.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4b37ae7b-3ba1-4e28-bd84-d886fe7fa243"
      }
    },
    "owner": "shinn_dev"
  }
}
